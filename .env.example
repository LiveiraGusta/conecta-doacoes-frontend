# Copie para .env.local e ajuste. Nenhuma variável aqui é segredo: tudo com VITE_ vai para o navegador.

# URL base da API REST. O WebSocket é derivado dela (http → ws).
# Produção: front e API no mesmo site (app.<dominio> + api.<dominio>), senão o cookie de sessão não funciona.
VITE_API_URL=http://localhost:3333/api/v1

# "true" liga os dados falsos (MSW) no navegador. Use `npm run dev:mock` em vez de editar aqui.
VITE_USE_MOCKS=false
